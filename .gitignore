.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example
*client_secret*.json
google-oauth-client*.json

# JavaScript dependencies and build output.
node_modules/
dist/
.vite/

# Python environments and caches.
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Local development stack: logs, PIDs and simulated channel state.
logs/
backend/.simulation/

# Editor and operating-system files.
.DS_Store
Thumbs.db
.idea/
.vscode/
*.orig
*.bak
