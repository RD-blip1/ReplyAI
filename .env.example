# Local-only PostgreSQL values for Docker Compose. Never reuse these outside development.
POSTGRES_DB=replyai
POSTGRES_USER=replyai
POSTGRES_PASSWORD=replyai_dev_only

# Optional host ports. Leave unset for the defaults (5432 / 6379). If you change a port
# here, change the matching port in backend/.env (DATABASE_URL / REDIS_URL) to match.
# POSTGRES_PORT=5432
# REDIS_PORT=6379
