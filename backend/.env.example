# Copy to backend/.env and fill in locally. Never commit backend/.env.
# Values here match the defaults in ../.env.example and ../compose.yaml.

# --- Database and cache (must match the Compose services) ---
# If you changed POSTGRES_PORT / REDIS_PORT at the repository root, update the ports here.
DATABASE_URL=postgresql+asyncpg://replyai:replyai_dev_only@127.0.0.1:5432/replyai
REDIS_URL=redis://127.0.0.1:6379/0

# Origins allowed to call the API and to pass CSRF origin checks.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- Google OAuth (YouTube Data API v3) ---
# Absolute path to the downloaded Google Web-application OAuth client JSON.
# Keep this file OUTSIDE the repository. See docs/getting-started.md.
GOOGLE_OAUTH_CLIENT_SECRETS_FILE=/absolute/path/outside/ReplyAI/google-oauth-client.json
# Must match an "Authorized redirect URI" on the OAuth client exactly.
GOOGLE_REDIRECT_URI=http://127.0.0.1:8001/auth/google/callback

# Encrypts stored per-session Google tokens. Generate a fresh one locally:
#   python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Losing it makes stored tokens unreadable; never reuse a Google secret here.
TOKEN_ENCRYPTION_KEY=replace_with_locally_generated_fernet_key

# --- Application ---
FRONTEND_BASE_URL=http://127.0.0.1:5173
APP_ENVIRONMENT=development
# "legacy" keeps the simple workflow; "langgraph" enables triage + dual-classifier policy.
DRAFT_WORKFLOW_ENGINE=legacy

# --- AI draft model (OpenAI-compatible; Groq is the documented default) ---
# Configure BOTH roles explicitly. Base URL is the API prefix; the adapter appends
# /chat/completions. Groq examples:
#   PRIMARY_LLM_BASE_URL=https://api.groq.com/openai/v1
#   PRIMARY_LLM_MODEL=openai/gpt-oss-120b
#   SECONDARY_LLM_MODEL=openai/gpt-oss-20b
# Both API keys are usually the same Groq key. Drafting stays disabled while blank.
PRIMARY_LLM_BASE_URL=
PRIMARY_LLM_API_KEY=
PRIMARY_LLM_MODEL=
SECONDARY_LLM_BASE_URL=
SECONDARY_LLM_API_KEY=
SECONDARY_LLM_MODEL=
